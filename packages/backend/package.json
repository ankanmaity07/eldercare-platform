    "cors": "^2.8.5",
    "node-cron": "^3.0.3",
    "dotenv": "^16.3.1",
    "typescript": "^5.3.3",
    "@types/node": "^20.11.5",
    "@types/express": "^4.17.21",
    "@types/bcryptjs": "^2.4.6",
